# TMTools backend environment variables .
# Copy to .env and fill in real values for local dev; in a real
# deployment these come from the environment (see the stack repo).

# ── Core infra ────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://tmtools:tmtools@localhost:5433/tmtools
REDIS_URL=redis://localhost:6380/0

# ── OIDC (any OAuth2/OIDC provider) ─────────────────────────────────────────
OIDC_ISSUER_URL=https://authentik.example.com/application/o/tmtools/
OIDC_CLIENT_ID=changeme
OIDC_CLIENT_SECRET=changeme
OIDC_GROUPS_CLAIM=groups

# ── Local emergency admin (plan §3.9) ──────────────────────────────────
# Required — /admin_login is disabled entirely if left unset.
ADMIN_LOCAL_PASSWORD=changeme

# ── Secrets ─────────────────────────────────────────────────────────────
# Required — the app will not start if left unset.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme

# ── S3 / MinIO (plan §3.8 — also configurable from the Settings UI) ────
S3_ENDPOINT_URL=http://localhost:9000
# Optional. The externally-reachable URL clients (browsers, OBS browser
# sources) use to fetch presigned S3/MinIO URLs — as opposed to
# S3_ENDPOINT_URL above, which is only the internal URL the backend itself
# uses to talk to the S3-compatible service. Needed whenever S3_ENDPOINT_URL
# is a hostname a client outside the backend's own network can't resolve
# (e.g. a Docker-internal service name like `http://minio:9000`). Falls
# back to S3_ENDPOINT_URL if left unset, which is correct for real AWS S3
# but wrong for most local/in-cluster MinIO setups. Example value for a
# typical Docker Compose local setup:
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=tmtools
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── App / cluster ────────────────────────────────────────────────────────
APP_PORT=8000
# POD_IP is optional node address override; leave unset locally.
POD_IP=
# Seconds the public site API (/api/v1/public/site/*) is cached (in memory and in Redis); 0 disables.
PUBLIC_CACHE_TTL_SECONDS=3

# ── Cloudflare Tunnel (compose.yml's `cloudflared` service) ────────────
# From the tunnel's "Install connector" command in the Cloudflare dashboard.
# Never commit a real value — this is a live credential, not just config.
CLOUDFLARE_TUNNEL_TOKEN=changeme
